{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aitdsd:supplier-declaration:0.2.0",
  "title": "AI Training Data Supplier Declaration (AI-TDSD v0)",
  "description": "The supplier's signed declaration accompanying a delivery of training data, carrying the answers to Part 4 of AI Training Data Supplier Diligence: Requirements and Evidence, v0, in fixed fields. Published under the MIT License (see LICENSE). A published version is not changed; a breaking change is a new version with a new $id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "declaration_id",
    "delivery",
    "accountable_person",
    "declared_at",
    "components",
    "de_identification",
    "attestation",
    "evidence_package",
    "health_data",
    "financial_data",
    "term",
    "evaluation_use",
    "deletion_propagation",
    "relationship_disclosure",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "declaration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "The supplier's identifier for this declaration, unique per delivery."
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_hash",
        "hash_algorithm",
        "timestamp_token_hash"
      ],
      "properties": {
        "manifest_hash": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|[0-9a-f]{96}|[0-9a-f]{128})$",
          "description": "Hash of the hash manifest that lists every delivered file (R1)."
        },
        "hash_algorithm": {
          "enum": [
            "sha-256",
            "sha-384",
            "sha-512",
            "sha3-256",
            "blake3"
          ]
        },
        "timestamp_token_hash": {
          "$ref": "#/$defs/hex256",
          "description": "Hash of the RFC 3161 time-stamp token issued over manifest_hash (R1)."
        },
        "timestamp_authority": {
          "type": "string",
          "maxLength": 256,
          "description": "The time-stamp authority that issued the token."
        }
      }
    },
    "accountable_person": {
      "$ref": "#/$defs/person",
      "description": "The named person accountable for the answers (Part 4, question 14)."
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "source",
          "collection_method",
          "custodians",
          "collection_authority",
          "rights_basis"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Where the component came from (R1)."
          },
          "collection_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "custodians": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Every party that held the component between collection and delivery, in order."
          },
          "collection_authority": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The authority or terms under which the component was collected."
          },
          "rights_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "terms_traveling",
              "exclusion_mechanism"
            ],
            "properties": {
              "basis": {
                "enum": [
                  "ownership",
                  "license",
                  "consent",
                  "public-domain",
                  "statutory",
                  "unknown"
                ]
              },
              "basis_detail": {
                "type": "string",
                "maxLength": 2000
              },
              "terms_traveling": {
                "type": "string",
                "maxLength": 2000,
                "description": "Field-of-use limits, attribution, sublicensing, term (R2)."
              },
              "exclusion_mechanism": {
                "type": "string",
                "maxLength": 2000,
                "description": "How an individual or rights holder can exclude their material, and its service level (R2)."
              },
              "exclusion_requests_last_12_months": {
                "$ref": "#/$defs/count_pair"
              }
            }
          },
          "contains_health_information": {
            "type": "boolean"
          }
        }
      }
    },
    "de_identification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed",
        "tier"
      ],
      "properties": {
        "claimed": {
          "type": "boolean",
          "description": "Whether any part of the delivery is described as de-identified, anonymized, redacted or scrubbed (R3)."
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "attacker_assumed": {
          "$ref": "#/$defs/attacker"
        },
        "method": {
          "type": "string",
          "maxLength": 4000,
          "description": "The de-identification method; 'not measured' is admissible at the declared tier."
        },
        "measured_on": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_size",
            "population_size",
            "drawn_by",
            "drawn_when",
            "measured_at",
            "measured_by"
          ],
          "properties": {
            "sample_size": {
              "type": "integer",
              "minimum": 0
            },
            "population_size": {
              "type": "integer",
              "minimum": 0
            },
            "drawn_by": {
              "enum": [
                "supplier",
                "buyer",
                "independent-party",
                "procedure-unpredictable-to-supplier",
                "unknown"
              ]
            },
            "drawn_when": {
              "enum": [
                "before-buyer-questions",
                "after-buyer-questions",
                "unknown"
              ]
            },
            "measured_at": {
              "type": "string",
              "format": "date"
            },
            "measured_by": {
              "$ref": "#/$defs/person"
            }
          }
        },
        "residual": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "What the method does not cover or did not clear, stated plainly; 'unknown' is admissible; 'none' is not (R3)."
        },
        "measurement_record_hash": {
          "$ref": "#/$defs/hex256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claimed": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "attacker_assumed",
              "method",
              "residual"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claimed": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "enum": [
                  "measured",
                  "independently-attested"
                ]
              }
            }
          },
          "then": {
            "required": [
              "measured_on",
              "measurement_record_hash"
            ]
          }
        },
        {
          "properties": {
            "residual": {
              "not": {
                "pattern": "^\\s*([Nn][Oo][Nn][Ee]|[Nn][Ii][Ll]|[Zz][Ee][Rr][Oo]|0|[Nn]/[Aa])\\s*\\.?\\s*$"
              }
            }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offered"
      ],
      "properties": {
        "offered": {
          "type": "boolean",
          "description": "Whether any attestation, audit or verification accompanies the delivery (R4)."
        },
        "attester": {
          "type": "string",
          "maxLength": 512
        },
        "attester_relationships": {
          "type": "string",
          "maxLength": 4000,
          "description": "The attester's relationships with every party to the transaction."
        },
        "fee_fixed_before_result": {
          "type": "boolean"
        },
        "fee_depends_on_finding_sale_or_price": {
          "type": "boolean"
        },
        "prior_engagements": {
          "type": "string",
          "maxLength": 4000
        },
        "attestation_hash": {
          "$ref": "#/$defs/hex256"
        }
      },
      "if": {
        "properties": {
          "offered": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "attester",
          "attester_relationships",
          "fee_fixed_before_result",
          "fee_depends_on_finding_sale_or_price",
          "prior_engagements"
        ]
      }
    },
    "evidence_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_manifest",
        "timestamp_token",
        "declaration",
        "measurement_records",
        "certification_and_notice_material"
      ],
      "properties": {
        "hash_manifest": {
          "type": "boolean"
        },
        "timestamp_token": {
          "type": "boolean"
        },
        "declaration": {
          "type": "boolean"
        },
        "measurement_records": {
          "type": "boolean"
        },
        "certification_and_notice_material": {
          "type": "boolean",
          "description": "The certification by a qualified person and the notice material that FRE 902(11), (13) and (14) call for (R5)."
        }
      }
    },
    "health_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "expert-determination",
            "safe-harbor",
            "none"
          ]
        },
        "documentation_hash": {
          "$ref": "#/$defs/hex256"
        },
        "determination_person": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "role",
            "organization",
            "qualifications"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "organization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "qualifications": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "present": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "method",
              "documentation_hash"
            ],
            "properties": {
              "method": {
                "enum": [
                  "expert-determination",
                  "safe-harbor"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "expert-determination"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "determination_person"
            ]
          }
        }
      ]
    },
    "financial_data": {
      "description": "R11. Which of the three financial-data classes the delivery contains or derives from, and the evidence per class. 'none' requires the search that supports it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "account-data",
              "financial-institution-npi",
              "consumer-report"
            ]
          }
        },
        "search_performed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "How the absence of each class was established (pattern search for PAN with a Luhn check, field-name search for track data and verification codes, source review)."
        },
        "account_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sad_present",
            "pan_present",
            "pci_evidence_hash"
          ],
          "properties": {
            "sad_present": {
              "type": "boolean",
              "description": "Sensitive authentication data present in any form, including encrypted or hashed. PCI DSS 3.3.1 forbids its storage after authorization."
            },
            "pan_present": {
              "type": "boolean"
            },
            "pan_unreadable_approach": {
              "enum": [
                "one-way-hash",
                "truncation",
                "index-token",
                "strong-cryptography"
              ],
              "description": "PCI DSS 3.5.1 approach."
            },
            "correlatable_forms_present": {
              "type": "boolean",
              "description": "Whether hashed and truncated forms, or different truncation formats, of the same PAN are present without the controls 3.5.1 names."
            },
            "pci_evidence_type": {
              "enum": [
                "attestation-of-compliance",
                "report-on-compliance",
                "self-assessment-questionnaire"
              ]
            },
            "pci_evidence_hash": {
              "$ref": "#/$defs/hex256"
            },
            "environment_owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The entity whose environment the data left (the supplier or its processor)."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "pan_present": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "pan_unreadable_approach",
                  "correlatable_forms_present",
                  "pci_evidence_type"
                ]
              }
            }
          ]
        },
        "financial_institution_npi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "agreement_hash"
          ],
          "properties": {
            "basis": {
              "enum": [
                "6802-notice-and-opt-out",
                "6802-b2-service-provider",
                "6802-e-exception"
              ]
            },
            "exception_cited": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The 6802(e) paragraph relied on, where basis is 6802-e-exception."
            },
            "institution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "agreement_hash": {
              "$ref": "#/$defs/hex256"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "6802-e-exception"
                  }
                },
                "required": [
                  "basis"
                ]
              },
              "then": {
                "required": [
                  "exception_cited"
                ]
              }
            }
          ]
        },
        "consumer_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "circumstance",
            "certification_hash",
            "use_statement"
          ],
          "properties": {
            "circumstance": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The 15 U.S.C. 1681b(a) paragraph under which the report was obtained."
            },
            "certification_hash": {
              "$ref": "#/$defs/hex256"
            },
            "use_statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "How use in the delivery is within the stated circumstance."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classes": {
                "contains": {
                  "const": "account-data"
                }
              }
            }
          },
          "then": {
            "required": [
              "account_data"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classes": {
                "contains": {
                  "const": "financial-institution-npi"
                }
              }
            }
          },
          "then": {
            "required": [
              "financial_institution_npi"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classes": {
                "contains": {
                  "const": "consumer-report"
                }
              }
            }
          },
          "then": {
            "required": [
              "consumer_report"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classes": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "required": [
              "search_performed"
            ]
          }
        }
      ]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "one-time",
            "feed",
            "refresh",
            "renewing-license"
          ]
        },
        "re_measurement_interval_days": {
          "type": "integer",
          "minimum": 1
        },
        "declaration_per_delivery": {
          "type": "boolean"
        },
        "change_log_hash": {
          "$ref": "#/$defs/hex256"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "feed",
              "refresh",
              "renewing-license"
            ]
          }
        }
      },
      "then": {
        "required": [
          "re_measurement_interval_days",
          "declaration_per_delivery"
        ]
      }
    },
    "evaluation_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_for_evaluation"
      ],
      "properties": {
        "intended_for_evaluation": {
          "type": "boolean"
        },
        "distribution_history": {
          "type": "string",
          "maxLength": 4000,
          "description": "Whether any component has been published, sold or delivered elsewhere, and in what form (R8)."
        },
        "overlap_check": {
          "type": "string",
          "maxLength": 4000,
          "description": "Overlap checks against public benchmarks and their method; 'not checked' is admissible."
        },
        "separation_procedure": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "if": {
        "properties": {
          "intended_for_evaluation": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "distribution_history",
          "overlap_check",
          "separation_procedure"
        ]
      }
    },
    "deletion_propagation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure",
        "intake_mechanism_exists"
      ],
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "How a deletion or exclusion request received after delivery reaches the buyer, within what time, in what form (R9)."
        },
        "propagation_time_days": {
          "type": "integer",
          "minimum": 0
        },
        "intake_mechanism_exists": {
          "type": "boolean"
        },
        "requests_propagated_last_12_months": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "relationship_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "statement",
        "signed_by"
      ],
      "properties": {
        "complete": {
          "type": "boolean",
          "description": "The supplier affirms the disclosure covers every ownership, control, fee, revenue-share, commission and prior-engagement relationship among the parties (R10)."
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "signed_by": {
          "$ref": "#/$defs/person"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact_hash",
        "signed_at"
      ],
      "description": "The signature of the accountable person over this declaration (R5: the declaration is signed by a named person).",
      "properties": {
        "kind": {
          "enum": [
            "detached-digital-signature",
            "signed-pdf",
            "wet-ink-scan",
            "e-signature-service"
          ]
        },
        "artifact_hash": {
          "$ref": "#/$defs/hex256",
          "description": "SHA-256 of the signature artifact (the signature file, the signed PDF or the scan)."
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier": {
      "enum": [
        "declared",
        "measured",
        "independently-attested",
        "none"
      ]
    },
    "attacker": {
      "enum": [
        "T0-public-only",
        "T1-public-plus-one-release",
        "T2-insider-without-keys",
        "T3-insider-with-other-releases",
        "T4-model-access-black-box",
        "T5-model-access-grey-box",
        "none-stated"
      ],
      "description": "The attacker the de-identification assumes, on this document's fixed scale so claims can be compared across suppliers. T2 means access to the supplier's systems but not to any secret material used in de-identification."
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "organization"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contact": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "count_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received",
        "honored"
      ],
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "honored": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "de_identification": {
            "properties": {
              "tier": {
                "const": "independently-attested"
              }
            },
            "required": [
              "tier"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "attestation": {
            "properties": {
              "offered": {
                "const": true
              }
            },
            "required": [
              "offered"
            ]
          }
        }
      }
    }
  ]
}
